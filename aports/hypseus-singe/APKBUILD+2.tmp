pkgname=sdl3_image
pkgver=3.5.0
pkgrel=0
pkgdesc="Simple DirectMedia Layer 3 - Image Loading Library"
url="https://github.com"
arch="aarch64"
license="Zlib"
depends="sdl3"
makedepends="cmake build-base sdl3-dev libpng-dev"
subpackages="$pkgname-dev"
source="$pkgname-$pkgver.tar.gz::https://github.com/libsdl-org/SDL_image/archive/refs/tags/release-$pkgver.tar.gz"
builddir="$srcdir/SDL_image-release-$pkgver"
options="!check"

build() {
	mkdir -p "$builddir/build"
	cd "$builddir/build"

	cmake -DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_C_FLAGS="-O3 -mcpu=cortex-a53" \
		-DSDLIMAGE_AVIF=OFF \
		-DSDLIMAGE_TIFF=OFF \
		-DSDLIMAGE_WEBP=OFF \
		-DSDLIMAGE_JXL=OFF \
		../

	make -j4
}

package() {
	cd "$builddir/build"
	make DESTDIR="$pkgdir" install
}
